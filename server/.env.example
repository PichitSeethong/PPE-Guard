# Local paths. Keep D:/PPE_Server outside the project folder so upgrades do not delete data.
PPE_DATA_DIR=D:/PPE_Server
PPE_DATABASE_PATH=
PPE_EVIDENCE_DIR=
PPE_BACKUP_DIR=
# Flutter Web release files copied here by build_web_and_deploy_windows.bat.
PPE_WEB_DIST_DIR=

# Create a unique long random value before actual deployment.
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRE_MINUTES=480
CAMERA_API_KEY=CHANGE_THIS_TO_A_LONG_CAMERA_KEY

OFFLINE_AFTER_SECONDS=300
FACTORY_TIMEZONE=Asia/Bangkok
MAX_IMAGE_BYTES=8388608
REQUIRED_PPE=helmet,glasses,gloves,shoes,safety-vest
ALLOWED_ORIGINS=*

# Login lockout. Resets after the lock period or after admin password reset.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Only creates the first administrator when no matching username exists.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
BOOTSTRAP_ADMIN_DISPLAY_NAME=System Administrator
BOOTSTRAP_ADMIN_DEPARTMENT=Safety Department
